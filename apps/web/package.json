{
	"name": "web",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "vite --host :: --port 3000",
		"build": "node tools/generate-llms.js && npm run build:client && npm run build:ssr && node tools/prerender.js",
		"build:client": "vite build --outDir ../../dist/apps/web --emptyOutDir",
		"build:ssr": "vite build --ssr src/entry-server.jsx --outDir ../../dist/ssr --emptyOutDir",
		"start": "vite preview --outDir ../../dist/apps/web --host :: --port 3000",
		"lint": "eslint . --quiet; lint_status=$?; eslint \"src/**/*.jsx\" --config eslint.config.mjs --format ./eslint.unicode-escapes-formatter.mjs --no-error-on-unmatched-pattern; exit $lint_status",
		"lint:warn": "eslint ."
	},
	"dependencies": {
		"framer-motion": "^11.15.0",
		"lucide-react": "^0.469.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet-async": "^3.0.0",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@types/node": "^20.17.10",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.39.4",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.1.0",
		"globals": "^15.14.0",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.4.17",
		"vite": "^7.3.6"
	}
}
