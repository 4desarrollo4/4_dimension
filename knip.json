{
	"ignoreWorkspaces": [
		"apps/!(web|api)"
	],
	"workspaces": {
		".": {
			"entry": [],
			"project": []
		},
		"apps/web": {
			"entry": [
				"components.json",
				"eslint.unicode-escapes-plugin.mjs",
				"index.html",
				"jsconfig.json",
				"package.json",
				"src/App.jsx",
				"src/components/CountUp.jsx",
				"src/components/Reveal.jsx",
				"src/components/ScrollToTop.jsx",
				"src/components/Seo.jsx",
				"src/entry-server.jsx",
				"src/index.css",
				"src/pages/HomePage.jsx"
			],
			"project": [
				"src/**/*.{js,jsx,css}"
			],
			"paths": {
				"@/*": [
					"./src/*"
				]
			}
		}
	}
}
